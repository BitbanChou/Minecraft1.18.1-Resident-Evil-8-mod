{
  "type": "minecraft:jigsaw",
  "start_pool": "re8joymod:castle/start_pool",
  "size": 5,
  "max_distance_from_center": 100,
  "step": "surface_structures",

  // The biome tag to use for what biomes that this structure can spawn in"
  "biomes": "#re8joymod:has_structure/castle",

  "start_height": {
    "absolute": 0
  },
  "adapt_noise": true,
  "project_start_to_heightmap": "WORLD_SURFACE_WG",
  "use_expansion_hack": false,

  // What mobs can spawn over time in the structure.
  // Make sure you add the mob to the right category (monster, creature, etc)
  "spawn_overrides": {
    "creature": {
      "bounding_box": "piece",
      "spawns": [
        {
          "type": "minecraft:bat",
          "weight": 1,
          "minCount": 1,
          "maxCount": 1
        }
      ]
    }
  }
}